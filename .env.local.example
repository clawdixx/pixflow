# ============================================================
# Pixflow — Environment Variables
# ============================================================

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ============================================================
# Asaas Integration
# ============================================================
# Token da API Asaas (encontrado em: Asaas Configurações > Integrações > API Key)
ASAAS_API_KEY=your_asaas_api_key_here

# Token do webhook Asaas (configurado em: Asaas > Configurações > Webhooks)
ASAAS_WEBHOOK_TOKEN=your_asaas_webhook_token_here

# Modo mock (para desenvolvimento local sem credenciais reais)
ASAAS_MOCK=true

# ============================================================
# Z-API (WhatsApp)
# ============================================================
# Instance ID da sua instância Z-API
ZAPI_INSTANCE_ID=your_zapi_instance_id

# Token de acesso Z-API
ZAPI_TOKEN=your_zapi_token_here

# Modo mock (para desenvolvimento local sem credenciais reais)
ZAPI_MOCK=true

# ============================================================
# Inngest
# ============================================================
# Chave pública Inngest (para dev: encontrado no dashboard Inngest)
NEXT_PUBLIC_INNGEST_APP_ID=pixflow-local-dev
INNGEST_EVENT_KEY=your_inngest_event_key_here
INNGEST_SIGNING_KEY=your_inngest_signing_key_here

# ============================================================
# App
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_DOMAIN=localhost:3000
